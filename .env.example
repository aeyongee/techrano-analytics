# 값은 비워 둔다. 실제 값은 .env.local(로컬)과 Vercel env(Production)에만 넣는다.

# Supabase (공개 값)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key: 수집기·시드·검증 스크립트 전용
SUPABASE_SECRET_KEY=

# 관리자 판정(app_metadata.app_role = 'admin'과 함께 확인)
ADMIN_EMAIL=

# DB 예약(pg_cron) → /api/cron/sync 인증. Supabase Vault에도 같은 값을 넣는다(scripts/setup-db-cron.ts). openssl rand -hex 32
CRON_SECRET=

# Instagram (Meta 시스템 사용자 토큰)
META_ACCESS_TOKEN=
META_IG_USER_ID=
# 비우면 버전 없는 경로(검증된 방식). 고정하려면 v23.0 같은 값
META_GRAPH_VERSION=

# YouTube (Google OAuth, 앱 게시 후 발급한 refresh token)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
YT_UPLOADS_PLAYLIST_ID=
