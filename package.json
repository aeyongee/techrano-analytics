{
  "name": "techrano-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "sync": "tsx --env-file-if-exists=.env.local scripts/sync.ts",
    "probe": "tsx --env-file-if-exists=.env.local scripts/probe.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed-episodes.ts",
    "import-points": "tsx --env-file-if-exists=.env.local scripts/import-points.ts",
    "verify-rls": "tsx --env-file-if-exists=.env.local scripts/verify-rls.ts",
    "db:push": "npx -y supabase db push",
    "db:types": "npx -y supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
    "scan": "bash scripts/scan-secrets.sh",
    "check-setup": "tsx --env-file-if-exists=.env.local scripts/check-setup.ts",
    "set-env": "bash scripts/set-env.sh",
    "db:apply": "tsx --env-file-if-exists=.env.local scripts/db-apply.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.76.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
